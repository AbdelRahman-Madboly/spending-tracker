  "fixed_sql": [
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"key\" TEXT NOT NULL, \"label_ar\" TEXT NOT NULL, \"icon_name\" TEXT NOT NULL, \"color_key\" TEXT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "subcategories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"subcategories\" (\"key\" TEXT NOT NULL, \"category_key\" TEXT NOT NULL REFERENCES categories (\"key\"), \"label_ar\" TEXT NOT NULL, \"icon_name\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"items\" (\"id\" TEXT NOT NULL, \"name_ar\" TEXT NOT NULL, \"name_en\" TEXT NOT NULL, \"category_key\" TEXT NOT NULL REFERENCES categories (\"key\"), \"subcategory_key\" TEXT NULL REFERENCES subcategories (\"key\"), \"default_amount_piastres\" INTEGER NULL, \"barcode\" TEXT NULL, \"use_count\" INTEGER NOT NULL DEFAULT 0, \"last_used_at\" INTEGER NULL, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "capture_groups",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"capture_groups\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"raw_text\" TEXT NULL, \"clean_text\" TEXT NULL, \"parsed_by\" TEXT NULL, \"date\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"entries\" (\"id\" TEXT NOT NULL, \"date\" TEXT NOT NULL, \"amount_piastres\" INTEGER NOT NULL, \"category_key\" TEXT NOT NULL REFERENCES categories (\"key\"), \"subcategory_key\" TEXT NULL REFERENCES subcategories (\"key\"), \"item_id\" TEXT NULL, \"description\" TEXT NOT NULL DEFAULT '', \"payment_method\" TEXT NOT NULL DEFAULT 'Cash', \"photo_path\" TEXT NULL, \"source\" TEXT NOT NULL DEFAULT 'manual', \"note\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"quantity_milli\" INTEGER NULL, \"unit\" TEXT NULL, \"unit_price_piastres\" INTEGER NULL, \"capture_group_id\" TEXT NULL REFERENCES capture_groups (id), \"external_id\" TEXT NULL, \"reference\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "salary_periods",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"salary_periods\" (\"id\" TEXT NOT NULL, \"date_paid\" TEXT NOT NULL, \"amount_piastres\" INTEGER NOT NULL, \"evidence_photo_path\" TEXT NULL, \"note\" TEXT NULL, \"external_id\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "attachments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attachments\" (\"id\" TEXT NOT NULL, \"entry_id\" TEXT NULL REFERENCES entries (id), \"capture_group_id\" TEXT NULL REFERENCES capture_groups (id), \"kind\" TEXT NOT NULL, \"path\" TEXT NULL, \"body\" TEXT NULL, \"transcript\" TEXT NULL, \"duration_ms\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (entry_id IS NOT NULL OR capture_group_id IS NOT NULL));"
        }
      ]
    },
    {
