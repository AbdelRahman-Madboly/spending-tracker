        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"item_aliases\" (\"alias\" TEXT NOT NULL, \"item_id\" TEXT NOT NULL REFERENCES items (id), \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"alias\"));"
